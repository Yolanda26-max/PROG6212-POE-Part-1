@model RaceDay.Web.Models.EventFormViewModel

<div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>

<div class="mb-3">
    <label asp-for="EventName" class="form-label"></label>
    <input asp-for="EventName" class="form-control" />
    <span asp-validation-for="EventName" class="text-danger"></span>
</div>

<div class="row">
    <div class="col-md-6 mb-3">
        <label asp-for="EventDate" class="form-label"></label>
        <input asp-for="EventDate" class="form-control" />
        <span asp-validation-for="EventDate" class="text-danger"></span>
    </div>
    <div class="col-md-6 mb-3">
        <label asp-for="Location" class="form-label"></label>
        <input asp-for="Location" class="form-control" />
        <span asp-validation-for="Location" class="text-danger"></span>
    </div>
</div>

<div class="row">
    <div class="col-md-6 mb-3">
        <label asp-for="EventType" class="form-label"></label>
        <select asp-for="EventType" class="form-select">
            <option value="Run">Run</option>
            <option value="Walk">Walk</option>
            <option value="Cycle">Cycle</option>
        </select>
        <span asp-validation-for="EventType" class="text-danger"></span>
    </div>
    <div class="col-md-6 mb-3">
        <label asp-for="DistanceKm" class="form-label"></label>
        <input asp-for="DistanceKm" class="form-control" type="number" step="0.01" />
        <span asp-validation-for="DistanceKm" class="text-danger"></span>
    </div>
</div>

<div class="mb-3">
    <label asp-for="Description" class="form-label"></label>
    <textarea asp-for="Description" class="form-control" rows="4"></textarea>
    <span asp-validation-for="Description" class="text-danger"></span>
</div>

<div class="mb-4">
    <label asp-for="BannerImage" class="form-label"></label>

    @if (!string.IsNullOrEmpty(Model.ExistingBannerUrl))
    {
        <div class="mb-2">
            <img src="@Model.ExistingBannerUrl" alt="Current banner" class="img-fluid rounded"
                 style="max-height:160px;object-fit:cover;" />
            <div class="form-text">Current banner. Choose a new image below to replace it.</div>
        </div>
    }

    <input asp-for="BannerImage" class="form-control" type="file" accept=".jpg,.jpeg,.png,.webp" />
    <div class="form-text">Optional. JPG, PNG or WEBP, up to 5 MB.</div>
    <span asp-validation-for="BannerImage" class="text-danger"></span>
</div>
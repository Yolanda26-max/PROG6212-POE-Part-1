@model RaceDay.Web.Models.EventFormViewModel
@{
    ViewData["Title"] = "Create event";
}

<div class="row justify-content-center">
    <div class="col-lg-8">
        <div class="card shadow-sm">
            <div class="card-body p-4">
                <h2 class="mb-1">Create an event</h2>
                <p class="text-muted mb-4">Fill in the details. You can add categories after the event is created.</p>

                <form asp-action="Create" method="post" enctype="multipart/form-data" novalidate>
                    <partial name="_EventForm" model="Model" />
                    <button type="submit" class="btn btn-primary">Create event</button>
                    <a asp-action="Index" class="btn btn-outline-secondary">Cancel</a>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
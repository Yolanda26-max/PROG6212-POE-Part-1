@model List<RaceDay.Web.Models.EventDto>
@{
    ViewData["Title"] = "My events";
}

<div class="d-flex flex-wrap justify-content-between align-items-center mb-4">
    <h1 class="mb-0">My events</h1>
    <a asp-action="Create" class="btn btn-primary mt-2 mt-md-0">+ Create event</a>
</div>

@if (!Model.Any())
{
    <div class="card shadow-sm">
        <div class="card-body text-center py-5">
            <h4>No events yet</h4>
            <p class="text-muted">Create your first event to get started.</p>
            <a asp-action="Create" class="btn btn-primary">Create an event</a>
        </div>
    </div>
}
else
{
    <div class="card shadow-sm">
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead>
                        <tr>
                            <th>Event</th>
                            <th>Date</th>
                            <th>Type</th>
                            <th>Distance</th>
                            <th>Manage</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var e in Model)
                        {
                            <tr>
                                <td>
                                    <strong>@e.EventName</strong><br />
                                    <span class="text-muted small">@e.Location</span>
                                </td>
                                <td>@e.EventDate.ToString("dd MMM yyyy")</td>
                                <td>@e.EventType</td>
                                <td>@e.DistanceKm.ToString("0.##") km</td>
                                <td>
                                    <a asp-action="Edit" asp-route-id="@e.EventId" class="btn btn-sm btn-outline-primary">Edit</a>
                                    <a asp-action="Categories" asp-route-id="@e.EventId" class="btn btn-sm btn-outline-primary">Categories</a>
                                    <a asp-action="Enrolments" asp-route-id="@e.EventId" class="btn btn-sm btn-outline-primary">Enrolments</a>
                                    <a asp-action="Results" asp-route-id="@e.EventId" class="btn btn-sm btn-outline-primary">Results</a>
                                    <form asp-action="Delete" asp-route-id="@e.EventId" method="post" class="d-inline"
                                          onsubmit="return confirm('Delete this event? This also removes its categories, enrolments and results.');">
                                        <button type="submit" class="btn btn-sm btn-outline-danger">Delete</button>
                                    </form>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
}
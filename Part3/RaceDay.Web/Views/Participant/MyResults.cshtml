@model List<RaceDay.Web.Models.MyResultRow>
@{
    ViewData["Title"] = "My results";

    string Ordinal(int n)
    {
        if (n % 100 >= 11 && n % 100 <= 13) return n + "th";
        return (n % 10) switch
        {
            1 => n + "st",
            2 => n + "nd",
            3 => n + "rd",
            _ => n + "th"
        };
    }
}

<h1 class="mb-1">My results</h1>
<p class="text-muted mb-4">Your race history across the events you've entered.</p>

@if (!Model.Any())
{
    <div class="card shadow-sm">
        <div class="card-body text-center py-5">
            <h4>No results yet</h4>
            <p class="text-muted mb-0">Results appear here once an organiser has captured them after an event.</p>
        </div>
    </div>
}
else
{
    <div class="card shadow-sm">
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead>
                        <tr>
                            <th>Event</th>
                            <th>Date</th>
                            <th>Category</th>
                            <th>Finish time</th>
                            <th>Position</th>
                            <th>Status</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var row in Model)
                        {
                            var r = row.Result;
                            var statusClass = r.Status switch
                            {
                                "Finished" => "status-confirmed",
                                "Pending" => "status-pending",
                                _ => "status-cancelled"
                            };
                            <tr>
                                <td><strong>@r.EventName</strong></td>
                                <td>@(row.EventDate.HasValue? row.EventDate.Value.ToString("dd MMM yyyy") : "-")</td>
                                <td>@r.CategoryName</td>
                                <td>@(r.FinishTime.HasValue? r.FinishTime.Value.ToString(@"hh\:mm\:ss") : "-")</td>
                                <td>
                                    @if (r.Status == "Finished" && r.Position.HasValue)
                                    {
                                        <strong>@Ordinal(r.Position.Value)</strong>
                                        @if (row.TotalFinishers > 0)
                                        {
                                            <span class="text-muted">out of @row.TotalFinishers finisher@(row.TotalFinishers == 1 ? "" : "s")</span>
                                        }
                                    }
                                    else
                                    {
                                        <span>-</span>
                                    }
                                </td>
                                <td><span class="status-badge @statusClass">@r.Status</span></td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
}